@page "/dashboard/deployments"
@{
    ViewData["Title"] = "Deployments";
    Layout = "/Pages/Shared/_Layout.cshtml";
}

<div class="toolbar">
    <h1>Deployments</h1>
    <button class="btn btn-primary" onclick="openCreate()">+ New Deployment</button>
</div>
<div id="content"><div class="empty">Loading...</div></div>

<!-- Create / Edit Modal -->
<div class="modal-overlay" id="modal">
    <div class="modal">
        <h2 id="modalTitle">New Deployment</h2>
        <div id="modalError" class="alert alert-error" style="display:none"></div>
        <form onsubmit="return saveDeployment(event)">
            <input type="hidden" id="editId" />
            <div class="form-group" id="essenceGroup">
                <label>Essence</label>
                <select id="fEssence" required></select>
            </div>
            <div class="form-group">
                <label>Name</label>
                <input type="text" id="fName" required maxlength="200" />
            </div>
            <div class="form-group">
                <label>Cron Expression (optional)</label>
                <input type="text" id="fCron" maxlength="100" placeholder="e.g. 0 */6 * * *" />
            </div>
            <div class="form-group">
                <label>Webhook URL (optional)</label>
                <input type="url" id="fWebhook" maxlength="2000" placeholder="https://..." />
            </div>
            <div class="form-group">
                <label><input type="checkbox" id="fEnabled" checked /> Enabled</label>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" onclick="closeModal()">Cancel</button>
                <button type="submit" class="btn btn-primary" id="saveBtn">Create</button>
            </div>
        </form>
    </div>
</div>

<!-- Run History Modal -->
<div class="modal-overlay" id="runModal">
    <div class="modal" style="max-width:700px">
        <h2>Run History</h2>
        <div id="runContent"><div class="empty">Loading...</div></div>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" onclick="document.getElementById('runModal').classList.remove('open')">Close</button>
        </div>
    </div>
</div>

<script>
const token = localStorage.getItem('aura_token');
if (!token) window.location.href = '/dashboard/login';

const api = auraApi;

const ACTIVE_STATES = ['Queued', 'Running', 'Pending'];
let essences = [];
let deploymentsById = {};
// Latest validate verdict per deployment. Kept across the 5-second list refresh so a result stays visible.
let validationById = {};
let refreshTimer = null;

function badge(status) {
    const map = { Succeeded: 'success', Failed: 'danger', Running: 'warning', Queued: 'info', Cancelled: 'muted', Pending: 'muted' };
    return `<span class="badge badge-${map[status] || 'muted'}">${esc(status)}</span>`;
}

function runHref(deploymentId, runId) {
    return `/dashboard/run?deploymentId=${encodeURIComponent(deploymentId)}&runId=${encodeURIComponent(runId)}`;
}

function closeModal() { document.getElementById('modal').classList.remove('open'); }

// Returns false when the essence list could not be loaded.
async function loadEssences() {
    const data = await api('/api/v1/essences?limit=100');
    if (!data || data.error) return false;
    essences = data.items || [];
    return true;
}

async function openCreate() {
    document.getElementById('modalTitle').textContent = 'New Deployment';
    document.getElementById('saveBtn').textContent = 'Create';
    document.getElementById('saveBtn').disabled = true;  // enabled once essences load
    document.getElementById('editId').value = '';
    document.getElementById('fName').value = '';
    document.getElementById('fCron').value = '';
    document.getElementById('fWebhook').value = '';
    document.getElementById('fEnabled').checked = true;
    document.getElementById('essenceGroup').style.display = 'block';
    const error = document.getElementById('modalError');
    error.style.display = 'none';
    document.getElementById('modal').classList.add('open');

    const loaded = await loadEssences();
    if (document.getElementById('editId').value) return;  // user switched to Edit while loading
    const select = document.getElementById('fEssence');
    select.innerHTML = essences.map(e =>
        `<option value="${esc(e.id)}">${esc(e.name)} (v${esc(e.currentVersion)})</option>`).join('');
    if (!loaded) {
        error.textContent = 'Could not load your essences. Close this and try again.';
        error.style.display = 'block';
        document.getElementById('saveBtn').disabled = true;
    } else if (essences.length === 0) {
        error.innerHTML = 'A deployment runs an essence, so you need one first. <a href="/dashboard/essences">Create an essence</a>, then come back here.';
        error.style.display = 'block';
        document.getElementById('saveBtn').disabled = true;
    } else {
        document.getElementById('saveBtn').disabled = false;
    }
}

function openEdit(d) {
    document.getElementById('modalTitle').textContent = 'Edit Deployment';
    document.getElementById('saveBtn').textContent = 'Save';
    document.getElementById('saveBtn').disabled = false;
    document.getElementById('editId').value = d.id;
    document.getElementById('fName').value = d.name;
    document.getElementById('fCron').value = d.cronExpression || '';
    document.getElementById('fWebhook').value = d.webhookUrl || '';
    document.getElementById('fEnabled').checked = d.isEnabled;
    document.getElementById('essenceGroup').style.display = 'none'; // Can't change essence on edit
    document.getElementById('modalError').style.display = 'none';
    document.getElementById('modal').classList.add('open');
}

async function saveDeployment(e) {
    e.preventDefault();
    const id = document.getElementById('editId').value;
    const body = {
        name: document.getElementById('fName').value,
        cronExpression: document.getElementById('fCron').value || null,
        webhookUrl: document.getElementById('fWebhook').value || null,
        isEnabled: document.getElementById('fEnabled').checked
    };
    if (!id) body.essenceId = document.getElementById('fEssence').value;
    const res = id
        ? await api(`/api/v1/deployments/${id}`, { method: 'PUT', body: JSON.stringify(body) })
        : await api('/api/v1/deployments', { method: 'POST', body: JSON.stringify(body) });
    if (!res) return false;
    if (res.error) {
        document.getElementById('modalError').textContent = res.message;
        document.getElementById('modalError').style.display = 'block';
        return false;
    }
    if (id) delete validationById[id];  // structure may have changed; old result is stale
    closeModal();
    auraToast(id ? 'Deployment updated' : 'Deployment created');
    loadDeployments();
    return false;
}

async function deleteDeployment(id, name) {
    if (!confirm(`Delete deployment "${name}"?`)) return;
    const res = await api(`/api/v1/deployments/${id}`, { method: 'DELETE' });
    if (!res) return;
    if (res.error) { auraToast(res.message, 'error'); return; }
    auraToast('Deployment deleted');
    loadDeployments();
}

// Starts a run and links to its Run Theater page. The list stays put so progress shows up in place.
async function triggerRun(deploymentId, btn) {
    if (btn) btn.disabled = true;
    const data = await api(`/api/v1/deployments/${deploymentId}/runs`, { method: 'POST' });
    if (btn) btn.disabled = false;
    if (!data) return;
    if (data.error || !data.id) {
        auraToast(data.message || 'Could not start the run. Try again.', 'error');
        return;
    }
    delete validationById[deploymentId];
    const name = deploymentsById[deploymentId]?.name;
    auraToast(name ? `Run started for "${name}".` : 'Run started.', 'success',
        { href: runHref(deploymentId, data.id), label: 'Open in Run Theater →' });
    loadDeployments();
}

async function viewRuns(deploymentId) {
    const content = document.getElementById('runContent');
    document.getElementById('runModal').classList.add('open');
    content.innerHTML = '<div class="empty">Loading...</div>';
    const data = await api(`/api/v1/deployments/${deploymentId}/runs?limit=20`);
    if (!data) return;
    if (data.error) {
        content.innerHTML = errorState(data.message);
        return;
    }
    if (!data.items || data.items.length === 0) {
        content.innerHTML = emptyState('This deployment has not run yet. Press Run on the list and its runs will appear here.');
        return;
    }
    content.innerHTML = `<table><thead><tr>
        <th>Status</th><th>Started</th><th>Completed</th><th>Layers</th><th>Actions</th>
    </tr></thead><tbody>${data.items.map(r => {
        const started = r.startedAt ? new Date(r.startedAt).toLocaleString() : '-';
        const completed = r.completedAt ? new Date(r.completedAt).toLocaleString() : '-';
        const canCancel = r.status === 'Queued' || r.status === 'Running';
        return `<tr>
            <td>${badge(r.status)}</td><td>${esc(started)}</td><td>${esc(completed)}</td>
            <td>${r.layers?.length || '-'}</td>
            <td class="actions">
                <a class="btn btn-secondary btn-sm" href="${runHref(deploymentId, r.id)}">View</a>
                ${canCancel ? `<button class="btn btn-danger btn-sm" onclick="cancelRunDirect('${deploymentId}','${r.id}')">Cancel</button>` : ''}
            </td>
        </tr>`;
    }).join('')}</tbody></table>`;
}

async function cancelRunDirect(deploymentId, runId) {
    if (!confirm('Cancel this run?')) return;
    const res = await api(`/api/v1/deployments/${deploymentId}/runs/${runId}/cancel`, { method: 'POST' });
    if (!res) return;
    if (res.error) { auraToast(res.message, 'error'); return; }
    auraToast('Run cancelled');
    viewRuns(deploymentId);
}

// Look up from the cache instead of inlining JSON/names into onclick
// attributes — names containing quotes would break the attribute boundary.
function openEditById(id) { const d = deploymentsById[id]; if (d) openEdit(d); }
function deleteDeploymentById(id) { const d = deploymentsById[id]; if (d) deleteDeployment(d.id, d.name); }

async function validateDeployment(id) {
    validationById[id] = { checking: true };
    renderValidation(id);
    const data = await api(`/api/v1/deployments/${id}/validate`, { method: 'POST' });
    if (!data) return;
    validationById[id] = data.error ? { error: data.message || 'Validation could not run. Try again.' } : data;
    renderValidation(id);
}

function validationHtml(v) {
    if (!v) return '';
    if (v.checking) return '<div class="validate-panel" style="color:var(--muted)">Checking deployment…</div>';
    if (v.error) return `<div class="validate-panel">${errorState(v.error)}</div>`;
    if (v.isValid) return `<div class="validate-panel"><div class="alert alert-success" style="margin:0">${esc(v.message)}</div></div>`;
    const problems = (v.errors || []).map(e => `<li>${esc(e)}</li>`).join('');
    return `<div class="validate-panel"><div class="alert alert-error" style="margin:0">${esc(v.message)}${problems ? `<ul>${problems}</ul>` : ''}</div></div>`;
}

function renderValidation(id) {
    const row = document.getElementById('validate-' + id);
    if (!row) return; // not on screen right now
    const v = validationById[id];
    row.style.display = v ? '' : 'none';
    row.firstElementChild.innerHTML = validationHtml(v);
}

async function loadDeployments() {
    const content = document.getElementById('content');
    const data = await api('/api/v1/deployments?limit=100');
    if (!data) return;
    if (data.error) {
        content.innerHTML = errorState(data.message);
        return;
    }

    const items = data.items || [];
    if (items.length === 0) {
        content.innerHTML = emptyState(
            'Deployments run an essence on demand or on a schedule. Create one to put an essence to work.',
            '<button class="btn btn-primary" onclick="openCreate()">+ New Deployment</button>');
        return;
    }
    deploymentsById = Object.fromEntries(items.map(d => [d.id, d]));
    // Pick up essences created since the page loaded so names don't fall back to "Unknown essence".
    if (items.some(d => !essences.some(e => e.id === d.essenceId))) await loadEssences();

    // latestRun now ships inside the list response — no per-row runs query.
    let html = '<table><thead><tr><th>Name</th><th>Essence</th><th>Schedule</th><th>Status</th><th>Latest Run</th><th>Actions</th></tr></thead><tbody>';
    for (const d of items) {
        const latest = d.latestRun;
        const essName = essences.find(e => e.id === d.essenceId)?.name || 'Unknown essence';
        const latestCell = latest
            ? `<a href="${runHref(d.id, latest.id)}" title="Open in Run Theater">${badge(latest.status)}</a> ${esc(new Date(latest.createdAt).toLocaleString())}`
            : '<span style="color:var(--muted)">Never run</span>';
        html += `<tr>
            <td>${esc(d.name)}</td>
            <td>${esc(essName)}</td>
            <td><code>${esc(d.cronExpression) || 'manual'}</code></td>
            <td>${d.isEnabled ? '<span class="badge badge-success">Enabled</span>' : '<span class="badge badge-muted">Disabled</span>'}</td>
            <td>${latestCell}</td>
            <td class="actions">
                ${d.isEnabled
                    ? `<button class="btn btn-primary btn-sm" onclick="triggerRun('${d.id}', this)">Run</button>`
                    : `<button class="btn btn-primary btn-sm" disabled title="Enable this deployment to run it">Run</button>`}
                <button class="btn btn-secondary btn-sm" onclick="validateDeployment('${d.id}')">Validate</button>
                <button class="btn btn-secondary btn-sm" onclick="viewRuns('${d.id}')">Runs</button>
                <button class="btn btn-secondary btn-sm" onclick="openEditById('${d.id}')">Edit</button>
                <button class="btn btn-danger btn-sm" onclick="deleteDeploymentById('${d.id}')">Delete</button>
            </td>
        </tr>
        <tr class="validate-row" id="validate-${d.id}" style="display:none"><td colspan="6"></td></tr>`;
    }
    html += '</tbody></table>';
    content.innerHTML = html;
    Object.keys(validationById).forEach(renderValidation);

    // Live status: keep polling while any run is in flight so badges flip
    // Queued → Running → Succeeded without a manual reload.
    clearTimeout(refreshTimer);
    if (items.some(d => ACTIVE_STATES.includes(d.latestRun?.status))) {
        refreshTimer = setTimeout(loadDeployments, 5000);
    }
}

// Preload essences then load deployments
(async () => {
    await loadEssences();
    loadDeployments();
})();
</script>
